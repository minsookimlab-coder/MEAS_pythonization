# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ── 가상환경 ──────────────────────────────────────────────────────────────
.venv/
venv/
env/

# ── 빌드 산출물 (PyInstaller) ─────────────────────────────────────────────
build/
dist/
*.manifest
*.spec.bak

# ── 패키징 ────────────────────────────────────────────────────────────────
*.egg-info/
.eggs/
pip-wheel-metadata/

# ── 테스트 / 도구 캐시 ────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── 런타임 설정·로그 (사용자 데이터, 저장소에 넣지 않음) ──────────────────
settings/
logs/
*.log
# 전역 설정 — smtp_password / telegram_bot_token 이 담기므로 추적하지 않는다.
# 형식은 app_config.example.yaml 참고. 없으면 앱이 기본값으로 새로 만든다.
app_config.yaml

# ── 측정 데이터 ───────────────────────────────────────────────────────────
*.dat

# ── 임시/작업 파일 ────────────────────────────────────────────────────────
_diff_*.txt
memo.txt
*.tmp
*.bak
*~

# ── OS / 에디터 ───────────────────────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store
.idea/
